# ==============================================================================
# Telegram Bot Loggers - Example Environment Configuration
# Copy this file to .env and insert your real Telegram Bot Tokens:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot Tokens: Comma-separated list of Bot Tokens (from @BotFather)
TELEGRAM_BOTS="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ,987654321:ZYXwvuTsRqPoNmlKjIhGfEdCba"

# Default Target Chat and Topic ID (Optional)
DEFAULT_CHAT_ID="-1001234567890"
DEFAULT_TOPIC_ID="1"

# HTTP Server Port
APP_PORT=8080

# Environment: development or production
APP_ENV=production

# Request Timeout for Telegram API in seconds
TELEGRAM_TIMEOUT=10
